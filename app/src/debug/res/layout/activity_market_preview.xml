<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/marketPreviewRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
>
    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/marketPreviewInfo"
        android:layout_width="@dimen/touch_min" android:layout_height="@dimen/touch_min"
        android:src="@drawable/ic_info" android:tint="@color/textSecondary"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/content_desc_how_to_read"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@+id/marketPreviewTitle" style="@style/TitleBar"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:maxLines="1" android:ellipsize="end" android:text="@string/market_preview_title"
        app:layout_constraintStart_toEndOf="@id/marketPreviewInfo"
        app:layout_constraintEnd_toStartOf="@id/marketPreviewCurrency"
        app:layout_constraintTop_toTopOf="@id/marketPreviewInfo"
        app:layout_constraintBottom_toBottomOf="@id/marketPreviewInfo" />
    <com.google.android.material.button.MaterialButton android:id="@+id/marketPreviewCurrency"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:minWidth="@dimen/touch_min" android:minHeight="@dimen/touch_min"
        android:layout_marginEnd="@dimen/space_s"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <androidx.fragment.app.FragmentContainerView android:id="@+id/marketPreviewContent"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/marketPreviewCurrency"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

