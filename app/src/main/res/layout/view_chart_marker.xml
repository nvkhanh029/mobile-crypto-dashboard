<?xml version="1.0" encoding="utf-8"?>
<!-- Touch marker of the price chart (FR-CD-04). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/corner_m"
    app:strokeColor="@color/divider"
    app:strokeWidth="@dimen/divider_thickness">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_s"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/space_s"
        android:paddingBottom="@dimen/space_xs">

        <TextView
            android:id="@+id/chartMarkerPrice"
            style="@style/Price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="@dimen/chart_marker_max_width" />

        <TextView
            android:id="@+id/chartMarkerTime"
            style="@style/Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="@dimen/chart_marker_max_width" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
