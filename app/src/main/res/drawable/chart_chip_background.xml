<?xml version="1.0" encoding="utf-8"?>
<!-- Apple-Stocks-style range chip: smaller pill inside the 48 dp touch target. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset
            android:insetLeft="@dimen/space_s"
            android:insetRight="@dimen/space_s"
            android:insetTop="@dimen/space_m"
            android:insetBottom="@dimen/space_m">
            <shape android:shape="rectangle">
                <solid android:color="@color/divider" />
                <corners android:radius="@dimen/corner_pill" />
            </shape>
        </inset>
    </item>
    <item>
        <inset
            android:insetLeft="@dimen/space_s"
            android:insetRight="@dimen/space_s"
            android:insetTop="@dimen/space_m"
            android:insetBottom="@dimen/space_m">
            <shape android:shape="rectangle">
                <solid android:color="@android:color/transparent" />
                <corners android:radius="@dimen/corner_pill" />
            </shape>
        </inset>
    </item>
</selector>
